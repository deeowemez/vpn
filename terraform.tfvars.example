# Copy to terraform.tfvars and adjust.

region = "ap-southeast-2" # Sydney
name   = "vpn-syd"

# t4g.small handles a couple of 1080p streams comfortably. Step up to
# t4g.medium only if several people are watching at once.
instance_type = "t4g.small"

# Stable hostname for the tunnel endpoint. Run 'make dns HOST=...' once to
# create the Route 53 zone, delegate the subdomain at your registrar, then
# 'make keys HOST=...' to generate configs that never need replacing.
# Leave commented out to dial the raw IP, which changes on every rebuild.
# vpn_hostname = "vpn.example.com"

# One config per device you want to connect. Keys are regenerated on every
# rebuild, so keep this to the devices you actually use.
client_count = 3

# Terminate the instance after this many minutes with no client handshake.
# The cost guardrail for the build-per-match workflow: switch the VPN off on
# your device when the match ends and the server disposes of itself.
idle_shutdown_minutes = 30

# WireGuard drops unauthenticated packets, so a wide-open UDP port is
# acceptable. Narrow it if your ISP prefix is stable.
allowed_vpn_cidrs = ["0.0.0.0/0"]

# 443 or 53 can slip past networks that block high UDP ports.
wg_port = 51820

# Use SSM Session Manager instead of SSH where you can.
enable_ssh        = false
allowed_ssh_cidrs = []
# ssh_key_name    = "my-keypair"

tags = {
  Owner = "me"
}

# Must match instance_type: arm64 for t4g/c6g/m7g, amd64 for t3/m5/c5.
ami_architecture = "arm64"
