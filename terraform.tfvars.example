# Copy to terraform.tfvars and adjust.

region = "ap-southeast-2" # Sydney
name   = "vpn-syd"

# t4g.small handles a couple of 1080p streams comfortably. t4g.medium or
# c6gn.medium if you are pushing 4K or several clients at once.
instance_type = "t4g.small"

# One config per device you want to connect.
client_count = 3

# WireGuard drops unauthenticated packets, so a wide-open UDP port is
# acceptable. Narrow it if your ISP prefix is stable.
allowed_vpn_cidrs = ["0.0.0.0/0"]

# 443 or 53 can slip past networks that block high UDP ports.
wg_port = 51820

# Use SSM Session Manager instead of SSH where you can.
enable_ssh        = false
allowed_ssh_cidrs = []
# ssh_key_name    = "my-keypair"

tags = {
  Owner = "me"
}

# Must match instance_type: arm64 for t4g/c6g/m7g, amd64 for t3/m5/c5.
ami_architecture = "arm64"
