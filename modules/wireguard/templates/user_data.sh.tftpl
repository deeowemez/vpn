#!/usr/bin/env bash
# Bootstraps a WireGuard server.
#
# Two modes. With a keyset supplied (scripts/gen-keys.sh), the server adopts it
# and the operator's existing client configs keep working across rebuilds.
# Without one, it generates throwaway keys and configs that
# scripts/fetch-clients.sh collects over SSM.
#
# Log: /var/log/wg-bootstrap.log
set -euo pipefail
exec > >(tee -a /var/log/wg-bootstrap.log) 2>&1

export DEBIAN_FRONTEND=noninteractive

WG_PORT="${wg_port}"
WG_MTU="${wg_mtu}"
WG_SUBNET="${wg_subnet_cidr}"
SERVER_IP="${server_wg_ip}"
CLIENT_COUNT="${client_count}"
DNS_UPSTREAM="${dns_upstream}"
IDLE_MINUTES="${idle_shutdown_minutes}"
SERVER_PRIV_PROVIDED='${server_private_key}'
ENDPOINT_OVERRIDE='${vpn_endpoint}'

echo "=== wg-bootstrap starting at $(date -Is) ==="

# This stack is ephemeral, so boot time is the thing to optimise. Only the
# packages actually needed, no recommends, and no AWS CLI - the fetch script
# reads anything required out over SSM from the operator's machine instead.
apt-get update -y
apt-get install -y --no-install-recommends wireguard-tools dnsmasq iptables

if [ -n "$ENDPOINT_OVERRIDE" ]; then
  # A DNS name Terraform points at this instance. Stable across rebuilds.
  ENDPOINT="$ENDPOINT_OVERRIDE"
else
  # No Elastic IP in this design: the address is assigned at launch, so the
  # instance has to look it up rather than have it templated in.
  IMDS_TOKEN="$(curl -fsS -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 300")"
  ENDPOINT="$(curl -fsS -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" \
    "http://169.254.169.254/latest/meta-data/public-ipv4")"
fi
echo "Public endpoint: $ENDPOINT:$WG_PORT"

# Route client traffic, and blackhole IPv6 rather than letting it leak around
# the tunnel to the client's real ISP address.
cat > /etc/sysctl.d/99-wireguard.conf <<'SYSCTL'
net.ipv4.ip_forward = 1
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
SYSCTL
sysctl --system

WAN_IF="$(ip -4 route show default | awk '{print $5}' | head -n1)"
echo "WAN interface: $WAN_IF"

umask 077
mkdir -p /etc/wireguard/clients
cd /etc/wireguard

if [ -n "$SERVER_PRIV_PROVIDED" ]; then
  SERVER_PRIV="$SERVER_PRIV_PROVIDED"
  echo "Using the supplied keyset; client configs are already on your devices."
else
  wg genkey > server.key
  wg pubkey < server.key > server.pub
  SERVER_PRIV="$(cat server.key)"
  SERVER_PUB="$(cat server.pub)"
  echo "Generating a throwaway keyset."
fi

cat > /etc/wireguard/wg0.conf <<SERVERCONF
[Interface]
Address = $SERVER_IP/$(echo "$WG_SUBNET" | cut -d/ -f2)
ListenPort = $WG_PORT
PrivateKey = $SERVER_PRIV
MTU = $WG_MTU
PostUp = iptables -A FORWARD -i %i -j ACCEPT; iptables -A FORWARD -o %i -j ACCEPT; iptables -t nat -A POSTROUTING -s $WG_SUBNET -o $WAN_IF -j MASQUERADE
PostDown = iptables -D FORWARD -i %i -j ACCEPT; iptables -D FORWARD -o %i -j ACCEPT; iptables -t nat -D POSTROUTING -s $WG_SUBNET -o $WAN_IF -j MASQUERADE
SERVERCONF

if [ -n "$SERVER_PRIV_PROVIDED" ]; then
  # Peer stanzas were rendered by Terraform from keys/peers.conf, so nothing
  # here has to parse them.
  cat >> /etc/wireguard/wg0.conf <<'PEERS'
${peer_stanzas}
PEERS
else
  SUBNET_PREFIX="$(echo "$SERVER_IP" | cut -d. -f1-3)"

  for i in $(seq 1 "$CLIENT_COUNT"); do
    NAME="client$i"
    CLIENT_ADDR="$SUBNET_PREFIX.$((i + 1))"

    wg genkey > "clients/$NAME.key"
    wg pubkey < "clients/$NAME.key" > "clients/$NAME.pub"
    CLIENT_PRIV="$(cat "clients/$NAME.key")"
    CLIENT_PUB="$(cat "clients/$NAME.pub")"

    cat >> /etc/wireguard/wg0.conf <<PEERCONF

[Peer]
# $NAME
PublicKey = $CLIENT_PUB
AllowedIPs = $CLIENT_ADDR/32
PEERCONF

    # DNS points at the server's tunnel address so lookups resolve from inside
    # the AWS region instead of via the client's local resolver.
    cat > "clients/$NAME.conf" <<CLIENTCONF
[Interface]
PrivateKey = $CLIENT_PRIV
Address = $CLIENT_ADDR/32
DNS = $SERVER_IP
MTU = $WG_MTU

[Peer]
PublicKey = $SERVER_PUB
Endpoint = $ENDPOINT:$WG_PORT
AllowedIPs = 0.0.0.0/0, ::/0
PersistentKeepalive = 25
CLIENTCONF

    rm -f "clients/$NAME.key" "clients/$NAME.pub"
    echo "generated $NAME ($CLIENT_ADDR)"
  done
fi

# Resolver for tunnel clients. bind-dynamic lets dnsmasq attach to wg0 whenever
# it appears and keeps it off systemd-resolved's 127.0.0.53 socket.
cat > /etc/dnsmasq.d/wireguard.conf <<DNSMASQ
listen-address=$SERVER_IP
bind-dynamic
no-resolv
no-hosts
server=$DNS_UPSTREAM
domain-needed
bogus-priv
cache-size=1000
DNSMASQ

systemctl enable --now wg-quick@wg0
systemctl restart dnsmasq
systemctl enable dnsmasq

# Dead man's switch. The instance is billed by the second and is meant to live
# only as long as a match, so if no peer has completed a handshake recently it
# shuts itself down - which terminates it, since the instance is launched with
# instance_initiated_shutdown_behavior = terminate.
if [ "$IDLE_MINUTES" -gt 0 ]; then
  cat > /usr/local/bin/wg-idle-check <<IDLECHECK
#!/usr/bin/env bash
set -euo pipefail
IDLE_SECONDS=\$(( $IDLE_MINUTES * 60 ))

latest=0
while read -r _peer ts; do
  [ -n "\$ts" ] && [ "\$ts" -gt "\$latest" ] && latest="\$ts"
done < <(wg show wg0 latest-handshakes)

if [ "\$latest" -eq 0 ]; then
  # Nobody has ever connected; measure against uptime so a server nobody uses
  # still cleans itself up.
  idle_for=\$(cut -d. -f1 /proc/uptime)
else
  idle_for=\$(( \$(date +%s) - latest ))
fi

if [ "\$idle_for" -ge "\$IDLE_SECONDS" ]; then
  logger -t wg-idle-check "idle for \$idle_for seconds, shutting down"
  systemctl poweroff
else
  logger -t wg-idle-check "active, idle for \$idle_for seconds"
fi
IDLECHECK
  chmod 755 /usr/local/bin/wg-idle-check

  cat > /etc/systemd/system/wg-idle-check.service <<'IDLESERVICE'
[Unit]
Description=Terminate the VPN instance once no client has used it recently
After=wg-quick@wg0.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/wg-idle-check
IDLESERVICE

  cat > /etc/systemd/system/wg-idle-check.timer <<'IDLETIMER'
[Unit]
Description=Periodic idle check for the VPN instance

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
IDLETIMER

  systemctl daemon-reload
  systemctl enable --now wg-idle-check.timer
  echo "idle shutdown armed at $IDLE_MINUTES minutes"
fi

touch /var/lib/wg-bootstrap.done
echo "=== wg-bootstrap complete at $(date -Is) ==="
wg show
